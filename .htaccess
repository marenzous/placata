# PLACATA v2.0 — PHP + MySQL (Plesk: Apache + nginx)
Options -Indexes
DirectoryIndex index.php index.html
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Força HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # www -> sem www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # /privacidade sem barra -> /privacidade/
  RewriteRule ^privacidade$ /privacidade/ [L,R=301]
  # Fotos da versão estática (v1.x) mudaram de pasta
  RewriteRule ^assets/img/produtos/(.+)$ /uploads/produtos/$1 [R=301,L]
  # llms.txt gerado do banco (telefone sempre atualizado)
  RewriteRule ^llms\.txt$ llms.php [L]
  # Pastas internas: nunca acessíveis pela web
  RewriteRule ^(inc|instalar)(/|$) - [F,L]
</IfModule>

# Arquivos que nunca podem ser baixados: segredos, SQL, documentação, git
<FilesMatch "(^config\.local.*\.php$|\.(sql|md|log|bak|ini|sh|example)$|^\.(git|env|htaccess|user\.ini))">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
  AddDefaultCharset utf-8
  AddCharset utf-8 .html .css .js .txt .xml .svg .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/plain application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
